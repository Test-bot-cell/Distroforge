# Python bytecode and environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Local configuration and secrets
.env
.env.*
!.env.example

# Tests, coverage, and static analysis
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Python build outputs
*.egg-info/
.eggs/
build/
dist/
.pybuild/
pip-wheel-metadata/

# Where the golden-path workflow stages what it uploads. Never created by make check or
# by any local command; listed because a maintainer reproducing that workflow by hand will
# create it, and an untracked directory of .deb files beside the source is exactly what the
# patterns below exist to keep out of a commit.
golden-path-evidence/

# Debian package build outputs. During alpha, package builds are explicit only, with the
# single standing exception of the weekly golden path -- see docs/golden-path.md.
*.deb
*.dsc
*.build
*.buildinfo
*.changes
*.upload
*.debian.tar.*
*.orig.tar.*
.pc/
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/*.substvars
debian/*.debhelper
debian/*.debhelper*
debian/distroforge/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Local assistant state
.agents/
.codex/
